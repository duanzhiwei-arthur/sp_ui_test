  <key>WorkingDirectory</key>
  <string>/Users/macbookair/Desktop/sp_ui_test</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/macbookair</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SCHEDULED_TEST_MODE</key>
    <string>all</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>
      set -euo pipefail
      /opt/homebrew/bin/gh auth status --hostname github.com >/dev/null
      weekday=$(date '+%u')
      current_minutes=$((10#$(date '+%H') * 60 + 10#$(date '+%M')))
      if (( weekday > 5 )) || ! ((( current_minutes >= 660 &amp;&amp; current_minutes &lt; 675 )) || (( current_minutes >= 1110 &amp;&amp; current_minutes &lt; 1125 ))); then
        echo "[$(date '+%Y-%m-%d %H:%M:%S %z')] 当前不在触发窗口内，跳过补触发。"
        exit 0
      fi
      for attempt in 1 2 3; do
        if /opt/homebrew/bin/gh workflow run ui-regression.yml --repo duanzhiwei-arthur/sp_ui_test --ref main --field mode=all --field simulate_failure_record=false; then
          echo "[$(date '+%Y-%m-%d %H:%M:%S %z')] 远端 workflow_dispatch 已提交。"
          exit 0
        fi
        (( attempt &lt; 3 )) &amp;&amp; sleep 15
      done
      echo "[$(date '+%Y-%m-%d %H:%M:%S %z')] 远端 workflow_dispatch 连续 3 次提交失败。" >&amp;2
      exit 1
    </string>
  </array>
