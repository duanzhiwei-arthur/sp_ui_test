# 线上游客态测试地址
BASE_URL=https://jujubit.ai
# 可选：指定 Create 商品完整地址（含 variant），未配置时使用 /products/customize-your-own。
PRODUCT_URL=

# 请在 assets/ 中放入无隐私、无版权争议的测试素材后填写相对路径。
TEST_IMAGE_SOLO=assets/solo.jpg
TEST_IMAGE_DUO=assets/duo.jpg
TEST_IMAGE_LARGE=assets/large.jpg
TEST_PROMPT=A friendly fantasy adventurer in a forest

# 只在页面文案稳定后填写；留空则跳过模型下拉选择断言。
TEST_MODEL_LABEL=

# 手动运行线上生成时显式设置为 true。
ALLOW_PRODUCTION_GENERATION=false

# 独立埋点专项的站点根地址；埋点测试从首页（TRACKING_ENTRY_URL，默认 /）
# 点击站内 Create 进入自定义器，而不是直接打开商品页。
# 运行：TRACKING_BASE_URL=https://test.example.com npm run test:tracking
TRACKING_BASE_URL=
# 可选：首页入口路径。生产环境默认等同于 https://jujubit.ai/。
TRACKING_ENTRY_URL=/
# 仅在明确授权生产埋点验证时设置；生产域名默认拒绝执行。
ALLOW_PRODUCTION_TRACKING=false

# Monitor/Statsig 浏览器上报地址的逗号分隔片段。Monitor 默认也识别 /api/collect/batch/add。
TRACKING_MONITOR_URL_PATTERNS=test-monorepo-monitor-server.jujubit.ai/api/collect/batch/add
TRACKING_STATSIG_URL_PATTERNS=

# 事件出现与平台接收的等待上限（毫秒）。可点击控件的上限由 Playwright actionTimeout 控制。
TRACKING_EVENT_TIMEOUT_MS=30000
TRACKING_DELIVERY_TIMEOUT_MS=15000
# 控件只短暂尝试点击；最终结果以埋点是否出现、单次上报、参数和送达状态为准。
TRACKING_CONTROL_TIMEOUT_MS=10000
# 严格模式：报告存在失败项时 Playwright 返回非零；默认 false 便于先产出完整报告。
TRACKING_STRICT=false

# 异常埋点专项只允许 Preview/本地地址；会 Mock 业务接口或注入浏览器资源故障。
TRACKING_FAULT_INJECTION_ENABLED=false
TRACKING_EXCEPTION_OUTPUT=test-results/tracking-exception-audit.json

# 每次本机埋点专项完成后，都在该 Wiki 节点下创建一份执行记录（通过和失败都会记录）。
# 企业应用机器人必须是该节点所在知识库成员，并对该节点具有编辑/创建子页面权限。
FEISHU_TRACKING_RECORDS_PARENT=

# 定时任务默认只执行 TC-01、TC-02。设置为 all 会执行全部 5 条 case，
# 每次产生 3 次真实生成、1 次加购并进入 Checkout；TC-05 会删除自己的 History 记录。
SCHEDULED_TEST_MODE=safe
# 当前定时任务不执行、不汇报埋点自动化；埋点专项仅允许手动运行。
SCHEDULED_TRACKING_ENABLED=false

# 企业应用机器人。凭证只写入本机 .env，禁止提交到代码库。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 单聊推荐 email 或 open_id；群聊使用 chat_id。
FEISHU_RECEIVE_ID_TYPE=email
FEISHU_RECEIVE_ID=

# 仅当定时用例失败时，在此 Wiki 节点下新建失败记录。GitHub Actions 中请设为同名 Secret，
# 并将企业应用机器人添加为该知识库成员，授予父节点编辑权限。
FEISHU_EXECUTION_RECORDS_PARENT=

# 失败后递归读取此 Wiki 节点下的文档，匹配已有解决方案。
FEISHU_SOLUTION_LIBRARY_ROOT=

# 本机 lark-cli 路径；Apple Silicon Homebrew 默认如下。
LARK_CLI_PATH=/opt/homebrew/bin/lark-cli

# 可选：ffmpeg 可执行文件路径。配置后把 WebM 转为飞书可直接播放的 MP4。
FFMPEG_PATH=

# 可选兼容通道：未配置企业应用机器人时发送纯文本，不支持截图和录屏。
FEISHU_WEBHOOK_URL=

# 机器人启用“签名校验”时填写；未启用可留空。
FEISHU_WEBHOOK_SECRET=
