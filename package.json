{
  "name": "jujubit-ui-regression",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:core-smoke": "playwright test tests/full-flow-inventory.spec.ts --grep @core-smoke",
    "test:experiments": "node automation/run-experiment-suite.mjs",
    "test:canvas": "playwright test --config experiments/canvas-v3/playwright.config.ts",
    "test:canvas:stable": "playwright test --config experiments/canvas-v3/stable.config.ts",
    "typecheck:canvas": "tsc --noEmit -p experiments/canvas-v3/tsconfig.json",
    "test:daily": "playwright test tests/00-safe-cases.spec.ts tests/full-flow-inventory.spec.ts tests/generation.spec.ts --grep 'TC-00|TC-01|TC-02|TC-03|TC-04|TC-05' --project=chromium",
    "test:daily:confirmed": "ALLOW_PRODUCTION_GENERATION=true CONFIRM_PRODUCTION_GENERATION=YES npm run test:daily",
    "test:scheduled": "node automation/run-and-notify.mjs",
    "test:daily:scheduled": "SCHEDULED_TEST_MODE=daily node automation/run-and-notify.mjs",
    "test:homepage-clickable:scheduled": "SCHEDULED_TEST_MODE=homepage-clickable node automation/run-and-notify.mjs",
    "feishu:experiment-command": "node automation/feishu-experiment-command.mjs",
    "feishu:experiment-bot": "node automation/feishu-experiment-bot.mjs",
    "scheduled:dispatch": "node automation/dispatch-scheduled-run.mjs",
    "scheduled:dispatch:hourly": "node automation/dispatch-scheduled-run.mjs",
    "test:all": "SCHEDULED_TEST_MODE=all node automation/run-and-notify.mjs",
    "test:all:headed": "SCHEDULED_TEST_MODE=all node automation/run-and-notify.mjs --headed",
    "notify:preview": "node automation/run-and-notify.mjs --notification-preview",
    "notify:test": "node automation/run-and-notify.mjs --notification-test",
    "record:preview": "node automation/run-and-notify.mjs --execution-record-preview",
    "record:test": "node automation/run-and-notify.mjs --execution-record-test",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test automation/*.test.mjs",
    "syntaxcheck": "for f in automation/*.mjs; do node --check \"$f\" || exit 1; done",
    "validate": "npm run typecheck && npm run typecheck:canvas && npm run syntaxcheck && npm run test:unit && playwright test --list --reporter=list",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
