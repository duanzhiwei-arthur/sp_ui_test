# 线上游客态测试地址
BASE_URL=https://jujubit.ai
# 可选：指定 Create 商品完整地址（含 variant），未配置时使用 /products/customize-your-own。
PRODUCT_URL=

# 请在 assets/ 中放入无隐私、无版权争议的测试素材后填写相对路径。
TEST_IMAGE_SOLO=assets/solo.jpg
TEST_IMAGE_DUO=assets/duo.jpg
TEST_IMAGE_LARGE=assets/large.jpg
TEST_PROMPT=A friendly fantasy adventurer in a forest
# TC-06 会员实验固定分组 ID；需先加入会员实验组。
TEST_MEMBERSHIP_STABLE_ID=jujubit-ui-e2e-membership-20260902
# Control 组固定 ID；配置后运行 TC-EXP-01，未配置时明确跳过。
TEST_MEMBERSHIP_CONTROL_STABLE_ID=
# Statsig Client SDK Key；用于运行时计算 stable_id 的 localStorage 键。
TEST_STATSIG_CLIENT_KEY=client-2tnhqG57crRsKHR9oTHbP4UsCNu7zQjghyI8otQUMU4
# 新画板五条保留独立Preview配置，不自动加入daily。
CANVAS_PARITY_BASE_URL=
CANVAS_PARITY_ALLOW_GENERATION=false
CANVAS_PARITY_LEDGER=
# 飞书事件桥接进程（部署在云 VM/容器）使用的机器人 open_id；留空则接受所有 @机器人 消息。
FEISHU_BOT_OPEN_ID=
# 远端 GitHub Actions dispatch 所需 fine-grained token（仅授予该仓库 Actions: write）。
# 该 token 只应保存在桥接服务的密钥管理器中；请勿填入本机 .env，更不要提交到代码库或写入日志。
GITHUB_TOKEN=
GITHUB_REPOSITORY=duanzhiwei-arthur/sp_ui_test
GITHUB_WORKFLOW_FILE=ui-regression.yml
GITHUB_REF=main

# 只在页面文案稳定后填写；留空则跳过模型下拉选择断言。
TEST_MODEL_LABEL=

# 手动运行线上生成时必须同时显式确认。
# 建议按次使用 npm run test:daily:confirmed，或设置：
# ALLOW_PRODUCTION_GENERATION=true CONFIRM_PRODUCTION_GENERATION=YES npm run test:daily
# 不要在 .env 中长期开启，以免裸跑 npm test 时意外产生真实生成任务和加购。
ALLOW_PRODUCTION_GENERATION=false
CONFIRM_PRODUCTION_GENERATION=NO

# 本地通知脚本默认安全模式；云端定时入口强制daily，TC-00～TC-05六条。
# daily 创建 3 次生成任务，TC-03 加购并进入 Checkout；不付款。
SCHEDULED_TEST_MODE=safe

# 企业应用机器人。凭证只写入本机 .env，禁止提交到代码库。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 单聊推荐 email 或 open_id；群聊使用 chat_id。
FEISHU_RECEIVE_ID_TYPE=email
FEISHU_RECEIVE_ID=
# 群聊失败时默认先单独发送一条 @所有人 提醒；设为 false 可关闭。
# 仅 FEISHU_RECEIVE_ID_TYPE=chat_id 时生效，且群聊必须允许机器人 @所有人。
FEISHU_MENTION_ALL_ON_FAILURE=true

# 仅当定时用例失败时，在此 Wiki 节点下新建失败记录。GitHub Actions 中请设为同名 Secret，
# 并将企业应用机器人添加为该知识库成员，授予父节点编辑权限。
FEISHU_EXECUTION_RECORDS_PARENT=

# 失败后递归读取此 Wiki 节点下的文档，匹配已有解决方案。
FEISHU_SOLUTION_LIBRARY_ROOT=

# 本机 lark-cli 路径；Apple Silicon Homebrew 默认如下。
LARK_CLI_PATH=/opt/homebrew/bin/lark-cli

# 可选：ffmpeg 可执行文件路径。配置后把 WebM 转为飞书可直接播放的 MP4。
FFMPEG_PATH=

# 可选兼容通道：未配置企业应用机器人时发送纯文本，不支持截图和录屏。
FEISHU_WEBHOOK_URL=

# 机器人启用“签名校验”时填写；未启用可留空。
FEISHU_WEBHOOK_SECRET=
