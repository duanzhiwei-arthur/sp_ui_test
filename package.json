{
  "name": "jujubit-ui-regression",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:core-smoke": "playwright test tests/full-flow-inventory.spec.ts --grep @core-smoke",
    "test:experiments": "playwright test tests/zz-experiments",
    "test:experiments:membership": "playwright test tests/zz-experiments/membership-banner.spec.ts",
    "test:experiments:canvas": "playwright test tests/00-safe-cases.spec.ts tests/zz-experiments/canvas-template.spec.ts --grep 'TC-02|TC-EXP-02'",
    "test:daily": "ALLOW_PRODUCTION_GENERATION=false playwright test --project=chromium",
    "test:tracking": "TRACKING_TEST_ENABLED=true TRACKING_RECORD_LABEL='完整埋点自动化' TRACKING_PLAYWRIGHT_ARGS='tests/tracking/analytics.spec.ts tests/tracking/catalog-audit.spec.ts' node automation/run-tracking-and-record.mjs",
    "test:tracking:contract": "TRACKING_TEST_ENABLED=true TRACKING_CONTRACT_TEST_ENABLED=true TRACKING_RECORD_LABEL='埋点契约自动化' TRACKING_PLAYWRIGHT_ARGS='tests/tracking/tracking-contract.spec.ts' node automation/run-tracking-and-record.mjs",
    "test:tracking:exceptions": "TRACKING_TEST_ENABLED=true TRACKING_FAULT_INJECTION_ENABLED=true TRACKING_RECORD_LABEL='异常埋点自动化' TRACKING_PLAYWRIGHT_ARGS='tests/tracking/exception-audit.spec.ts' node automation/run-tracking-and-record.mjs",
    "report:tracking": "node automation/render-tracking-report.mjs",
    "report:tracking:merge": "node automation/merge-tracking-reports.mjs",
    "test:scheduled": "node automation/run-and-notify.mjs",
    "test:daily:scheduled": "SCHEDULED_TEST_MODE=daily node automation/run-and-notify.mjs",
    "test:experiment:membership:scheduled": "SCHEDULED_TEST_MODE=experiment EXPERIMENT_KEY=membership node automation/run-and-notify.mjs",
    "feishu:experiment-command": "node automation/feishu-experiment-command.mjs",
    "feishu:experiment-bot": "node automation/feishu-experiment-bot.mjs",
    "test:all": "SCHEDULED_TEST_MODE=all node automation/run-and-notify.mjs",
    "test:all:headed": "SCHEDULED_TEST_MODE=all node automation/run-and-notify.mjs --headed",
    "notify:preview": "node automation/run-and-notify.mjs --notification-preview",
    "notify:test": "node automation/run-and-notify.mjs --notification-test",
    "record:preview": "node automation/run-and-notify.mjs --execution-record-preview",
    "record:test": "node automation/run-and-notify.mjs --execution-record-test",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && playwright test --list --reporter=list",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
