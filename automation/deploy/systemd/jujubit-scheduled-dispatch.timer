[Unit]
Description=Trigger JuJuBit scheduled UI regression at 11:17 and 18:47 Asia/Shanghai

[Timer]
# 精确触发时刻（北京时间）。与 workflow 内 schedule 兜底错开 30 分钟，
# dedupe_key 保证即便兜底也触发同一档，两个触发源不会重复执行。
OnCalendar=Mon..Fri *-*-* 11:17:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 18:47:00 Asia/Shanghai
# 若机器在触发时刻处于关机/休眠，开机后补跑一次。
Persistent=true
Unit=jujubit-scheduled-dispatch.service

[Install]
WantedBy=timers.target